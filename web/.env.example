# Copy to .env. Never commit .env.
# Optional: the administrator's fallback Anthropic API key. Every account can (and should) set its own key in the app under
# Instellingen; it is stored encrypted with that account's password.
ANTHROPIC_API_KEY=
# Optional: default model (built-in: claude-sonnet-5-5). A model picked under Instellingen in the app wins.
# CLAUDE_MODEL=claude-sonnet-5-5
# Optional: the same for ChatGPT (OpenAI), for an account that picks ChatGPT under Instellingen → AI-dienst.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# Optional: how long one AI analysis may take, in seconds (default 180).
# LOOKUP_SECONDS=180

# Enkel voor compose.tailscale.yaml: een auth key uit de Tailscale-admin (Settings → Keys): reusable uit,
# pre-approved, met de tag hieronder. Na de eerste start staat de login in ts-state/ en mag de key weg.
TS_AUTHKEY=
TS_TAG=tag:docker
